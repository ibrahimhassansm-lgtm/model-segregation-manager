{
  "manifest_version": 3,
  "name": "MSM Forma Scanner",
  "version": "1.3.5",
  "description": "Adds a Scan button inside Autodesk Forma and sends the model list to Model Segregation Manager. No API, no sign-in.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://acc.autodesk.com/*"
      ],
      "js": [
        "net.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://acc.autodesk.com/*"
      ],
      "js": [
        "forma.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ibrahimhassansm-lgtm.github.io/model-segregation-manager/*"
      ],
      "js": [
        "msm.js"
      ],
      "run_at": "document_start"
    }
  ]
}